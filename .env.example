# ---- Público (vai para o navegador) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://app.deltaflow.com.br
# "true" depois de ativar o provider Google no Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Web Push (opcional): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Limite de upload direto em MB. Supabase Free = 50. Aumente só depois de mudar de plano.
NEXT_PUBLIC_MAX_UPLOAD_MB=50
# Chave de API do Google (Cloud Console → Credenciais → Criar chave de API), restrita à "Google Drive API".
# Faz os vídeos do Drive tocarem no player do próprio aparelho (iPhone). Sem ela, usa o player do Drive.
NEXT_PUBLIC_GOOGLE_API_KEY=

# ---- Somente servidor (NUNCA prefixar com NEXT_PUBLIC_) -----------------------
SUPABASE_SERVICE_ROLE_KEY=
# Google Drive (OAuth "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32   (cifra AES-256-GCM dos tokens do Drive)
DRIVE_TOKEN_ENCRYPTION_KEY=
# E-mails transacionais
RESEND_API_KEY=
EMAIL_FROM="Delta Flow <no-reply@deltaflow.com.br>"
# openssl rand -hex 32   (Vercel Cron → /api/cron/deadlines)
CRON_SECRET=
VAPID_PRIVATE_KEY=

# ---- Testes de banco -----------------------------------------------------------
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
